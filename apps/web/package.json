{
  "name": "@tuvi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5291 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --ssr src/year/year-prerender.tsx --outDir dist-ssr && tsx prerender.ts",
    "preview": "vite preview --port 5291 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@achoo254/app-shell": "github:achoo254/shared-next#v0.8.0&path:/packages/app-shell",
    "@achoo254/brand": "github:achoo254/shared-next#v0.8.0&path:/packages/brand",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@tuvi/chart": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1"
  }
}
