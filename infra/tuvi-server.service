# .65: /etc/systemd/system/tuvi-server.service (installed by infra/deploy.sh setup).
[Unit]
Description=Tu Vi API (tuvi.hoandat.com)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=tuvi
Group=tuvi
# NODE_ENV=production, PORT=5290, PUBLIC_URL, DATABASE_URL, AUTH_ISSUER, AUTH_CLIENT_ID, AUTH_CLIENT_SECRET:
# written on the server from the env folder outside git (docs/deployment-guide.md), never in the repo.
EnvironmentFile=/etc/tuvi/production.env
WorkingDirectory=/var/www/tuvi/current
ExecStart=/opt/node22/bin/node --enable-source-maps /var/www/tuvi/current/apps/server/dist/server/index.mjs
Restart=on-failure
RestartSec=3
# .65 has 8 GB shared by every app; the API is small (charts are cast in the browser), so cap it.
MemoryHigh=160M
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
